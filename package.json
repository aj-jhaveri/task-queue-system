{
  "name": "task-queue-system",
  "version": "1.0.0",
  "description": "Production-Grade Asynchronous Task Processing System built with Node.js, TypeScript, BullMQ, Redis, and Express.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "bullmq",
    "redis",
    "typescript",
    "task-queue",
    "express",
    "pino",
    "zod",
    "idempotency",
    "dlq"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@bull-board/api": "^6.7.13",
    "@bull-board/express": "^6.7.13",
    "better-sqlite3": "^11.8.1",
    "bullmq": "^5.41.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.5.0",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
