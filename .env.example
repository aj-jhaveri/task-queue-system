# Copy to .env for local development. NEVER commit a real .env file.
# Every value below is a placeholder. Do not put real credentials in this file.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------
# REDIS_URL is the SOLE Redis connection variable in deployed environments.
# When set, it takes precedence over REDIS_HOST/REDIS_PORT/REDIS_PASSWORD.
# Upstash requires TLS; rediss:// is enforced automatically for upstash.io hosts.
# Example shape only - replace with your own and keep it out of version control:
#   REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=

# Local development fallback (used only when REDIS_URL is empty)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Public dashboard budget controls
# ---------------------------------------------------------------------------
# These are what make an unauthenticated, always-on Bull Board affordable on a
# free Redis tier. DASHBOARD_SNAPSHOT_TTL_MS is an IDLE BACKSTOP, not the refresh
# rate: dispatching or completing a job invalidates the snapshot immediately, so
# the board is live whenever anything is actually happening.
# Raising the poll interval is NOT a substitute for the cache - see
# docs/design_decisions.md Q4c before changing either value.
DASHBOARD_SNAPSHOT_TTL_MS=300000
DASHBOARD_POLL_INTERVAL_SECONDS=10
DASHBOARD_MAX_CACHE_ENTRIES=64

# Per-IP ceiling for the public dashboard. The snapshot cache bounds the polled
# route, but job-detail routes are intentionally uncached and reach Redis on every
# request, so they are capped. A polling tab uses ~6/min and an actively clicking
# human ~30/min, well under this.
DASHBOARD_RATE_LIMIT_MAX_PER_IP=120

# ---------------------------------------------------------------------------
# Webhook delivery job (the real retry demonstration)
# ---------------------------------------------------------------------------
# Timeout for the processor's real HTTP request to the loopback sink.
WEBHOOK_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Admin boundary (/metrics only)
# ---------------------------------------------------------------------------
# These guard /metrics ONLY. The queue dashboard at /admin/queues is public and
# read-only by design and does not use them.
# If either value is empty, /metrics refuses ALL requests (fail closed).
# Set both in your host's environment settings, never in git.
BULLBOARD_USER=
BULLBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated explicit allowlist. Wildcards ("*") are ignored by design.
CORS_ALLOWED_ORIGINS=https://slakedesign.com,https://www.slakedesign.com

# ---------------------------------------------------------------------------
# BullMQ worker tuning
# ---------------------------------------------------------------------------
# WORKER_DRAIN_DELAY_SECONDS and WORKER_STALLED_INTERVAL_MS are load-bearing for
# the Redis command budget. BullMQ's defaults (5 / 30000) cost ~37,440 Redis
# commands per idle day, which exceeds Upstash's free monthly allowance on its own.
# See docs/security-remediation.md before changing these.
WORKER_DRAIN_DELAY_SECONDS=60
WORKER_STALLED_INTERVAL_MS=300000
WORKER_CONCURRENCY=5

# BullMQ worker-side processing limiter (NOT HTTP intake limiting)
RATE_LIMIT_MAX=100
RATE_LIMIT_DURATION_MS=60000

# ---------------------------------------------------------------------------
# HTTP intake protection (in-memory; deliberately NOT Redis-backed)
# ---------------------------------------------------------------------------
HTTP_RATE_LIMIT_WINDOW_MS=60000
HTTP_RATE_LIMIT_MAX_PER_IP=20
HTTP_RATE_LIMIT_MAX_GLOBAL=200
JSON_BODY_LIMIT=16kb

# Proxy hops to trust for client IP resolution. Render uses 1.
# Required for per-IP rate limiting to see the real client address.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Queue safety ceiling (evaluated on demand at submit time only)
# ---------------------------------------------------------------------------
MAX_QUEUE_DEPTH=1000
QUEUE_DEPTH_CACHE_TTL_MS=5000

# ---------------------------------------------------------------------------
# SQLite idempotency store
# ---------------------------------------------------------------------------
SQLITE_DB_PATH=./data/idempotency.db
